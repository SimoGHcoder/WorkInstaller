@echo off
setlocal

echo ============================================================
echo           PULIZIA PROFONDA FILE TEMPORANEI E CACHE
echo ============================================================
echo.

:: 1. Arresto temporaneo del servizio Windows Update (sblocca la cache)
echo [1/6] Arresto temporaneo dei servizi di aggiornamento...
net stop wuauserv >nul 2>&1
net stop bits >nul 2>&1

:: 2. Svuotamento cartelle Temp utente e di sistema
echo [2/6] Svuotamento cartelle Temp (Utente e Sistema)...
del /Q /F /S "%TEMP%\*.*" >nul 2>&1
for /d %%p in ("%TEMP%\*") do rmdir /s /q "%%p" >nul 2>&1

del /Q /F /S "%systemroot%\Temp\*.*" >nul 2>&1
for /d %%p in ("%systemroot%\Temp\*") do rmdir /s /q "%%p" >nul 2>&1

:: 3. Pulizia della cache di Windows Update
echo [3/6] Pulizia cache dei download di Windows Update...
del /Q /F /S "%systemroot%\SoftwareDistribution\Download\*.*" >nul 2>&1
for /d %%p in ("%systemroot%\SoftwareDistribution\Download\*") do rmdir /s /q "%%p" >nul 2>&1

:: 4. Pulizia file Prefetch (ottimizzazione avvio)
echo [4/6] Pulizia file Prefetch di sistema...
del /Q /F /S "%systemroot%\Prefetch\*.*" >nul 2>&1

:: 5. Ripristino dei servizi Windows Update
echo [5/6] Riavvio dei servizi di aggiornamento...
net start bits >nul 2>&1
net start wuauserv >nul 2>&1

:: 6. Svuotamento del Cestino e della cache DNS
echo [6/6] Svuotamento Cestino e flush della cache DNS...
ipconfig /flushdns >nul 2>&1
powershell -NoProfile -Command "Clear-RecycleBin -Force -ErrorAction SilentlyContinue" >nul 2>&1

echo.
echo ============================================================
echo [OK] Pulizia profonda completata con successo!
echo ============================================================
echo.
pause
